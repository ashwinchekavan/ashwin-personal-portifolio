---
import '@fontsource/poppins/latin-300.css';
import '@fontsource/poppins/latin-400.css';
import '@fontsource/poppins/latin-500.css';
import '@fontsource/poppins/latin-600.css';
import '@fontsource-variable/playfair-display';
import '@fontsource/mrs-saint-delafield';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import sharePreview from '../assets/share-preview.jpg';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, fullUrl, metaDescription, url } from '../config';

interface Props {
  title?: string;
  description?: string;
  // An image link or uploaded image path is used as-is; a local image is resized for sharing.
  image?: ImageMetadata | string;
  type?: 'website' | 'article';
  article?: { publishedTime: Date; modifiedTime?: Date; section?: string };
  jsonLd?: object[];
  noindex?: boolean;
}

const {
  title,
  description: rawDescription = SITE.description,
  image = sharePreview,
  type = 'website',
  article,
  jsonLd = [],
  noindex = false,
} = Astro.props;

// Search results cut titles off at about 60 characters, so long titles drop the name suffix.
const pageTitle = !title ? SITE.title : `${title} | ${SITE.name}`.length > 60 ? title : `${title} | ${SITE.name}`;
const description = metaDescription(rawDescription);

// Analytics IDs are read at runtime (set them in hPanel). Only well-formed IDs are used.
const gaId = /^G-[A-Z0-9]{4,20}$/.test(process.env.GA_MEASUREMENT_ID ?? '') ? process.env.GA_MEASUREMENT_ID : '';
const clarityId = /^[a-z0-9]{4,20}$/.test(process.env.CLARITY_PROJECT_ID ?? '') ? process.env.CLARITY_PROJECT_ID : '';
const tracking = !noindex;
const canonicalPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = fullUrl(canonicalPath);
const ogImage =
  typeof image === 'string'
    ? fullUrl(image)
    : fullUrl((await getImage({ src: image, width: 1200, height: 630, format: 'jpg' })).src);
const serializeJsonLd = (data: object) =>
  JSON.stringify(data).replace(/</g, '\\u003c').replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="sitemap" href={url('/sitemap.xml')} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — Writing`} href={url('/rss.xml')} />
    <meta name="theme-color" content="#faf7f3" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {typeof image !== 'string' && <meta property="og:image:width" content="1200" />}
    {typeof image !== 'string' && <meta property="og:image:height" content="630" />}
    <meta property="og:locale" content="en_IN" />
    {article && <meta property="article:published_time" content={article.publishedTime.toISOString()} />}
    {article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />}
    {article?.section && <meta property="article:section" content={article.section} />}
    {article && <meta property="article:author" content={SITE.name} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={serializeJsonLd(data)} />)}

    {tracking && gaId && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />}
    {
      tracking && gaId && (
        <script is:inline data-ga={gaId}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', document.currentScript.dataset.ga);
        </script>
      )
    }
    {
      tracking && clarityId && (
        <script is:inline data-clarity={clarityId}>
          (function (c, l, a, r, i, t, y) {
            c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
            t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
            y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
          })(window, document, 'clarity', 'script', document.currentScript.dataset.clarity);
        </script>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
