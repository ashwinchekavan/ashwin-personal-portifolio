---
import '@fontsource/poppins/latin-300.css';
import '@fontsource/poppins/latin-400.css';
import '@fontsource/poppins/latin-500.css';
import '@fontsource/poppins/latin-600.css';
import '@fontsource-variable/playfair-display';
import '@fontsource/mrs-saint-delafield';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import sharePreview from '../assets/share-preview.jpg';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, fullUrl, url } from '../config';

interface Props {
  title?: string;
  description?: string;
  // An image link or uploaded image path is used as-is; a local image is resized for sharing.
  image?: ImageMetadata | string;
  type?: 'website' | 'article';
  article?: { publishedTime: Date; modifiedTime?: Date; section?: string };
  jsonLd?: object[];
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  image = sharePreview,
  type = 'website',
  article,
  jsonLd = [],
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE.name}` : SITE.title;
const canonical = fullUrl(Astro.url.pathname);
const ogImage =
  typeof image === 'string'
    ? fullUrl(image)
    : fullUrl((await getImage({ src: image, width: 1200, height: 630, format: 'jpg' })).src);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="sitemap" href={url('/sitemap.xml')} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — Writing`} href={url('/rss.xml')} />
    <meta name="theme-color" content="#faf7f3" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {typeof image !== 'string' && <meta property="og:image:width" content="1200" />}
    {typeof image !== 'string' && <meta property="og:image:height" content="630" />}
    <meta property="og:locale" content="en_IN" />
    {article && <meta property="article:published_time" content={article.publishedTime.toISOString()} />}
    {article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />}
    {article?.section && <meta property="article:section" content={article.section} />}
    {article && <meta property="article:author" content={SITE.name} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
