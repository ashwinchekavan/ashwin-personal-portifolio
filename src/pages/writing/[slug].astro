---
import { Image } from 'astro:assets';
import defaultPostCover from '../../assets/default-post-cover.jpg';
import Icon from '../../components/Icon.astro';
import Base from '../../layouts/Base.astro';
import { SITE, formatDate, fullUrl, url } from '../../config';
import { getPublishedBySlug } from '../../lib/posts';

const post = await getPublishedBySlug(Astro.params.slug ?? '');
if (!post) return Astro.rewrite('/404');

const { title, description, date: pubDate, updated: updatedDate, category, cover } = post;
const postUrl = fullUrl(`/writing/${post.slug}/`);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    articleSection: category,
    mainEntityOfPage: postUrl,
    author: { '@type': 'Person', name: SITE.name, url: fullUrl('/') },
    publisher: { '@type': 'Person', name: SITE.name, url: fullUrl('/') },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: fullUrl('/') },
      { '@type': 'ListItem', position: 2, name: 'Writing', item: fullUrl('/writing/') },
      { '@type': 'ListItem', position: 3, name: title, item: postUrl },
    ],
  },
];
---

<Base
  title={title}
  description={description}
  image={cover ?? undefined}
  type="article"
  article={{ publishedTime: pubDate, modifiedTime: updatedDate, section: category }}
  jsonLd={jsonLd}
>
  <article class="article">
    <header class="container article__head">
      <nav class="eyebrow breadcrumb" aria-label="Breadcrumb">
        <a href={url('/')}>Home</a> / <a href={url('/writing/')}>Writing</a> / <span>{category}</span>
      </nav>
      <h1 class="page-title">{title}</h1>
      <p class="lead">{description}</p>
      <p class="post-card__meta">
        By {SITE.name}
        <span aria-hidden="true">•</span>
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span aria-hidden="true">•</span>
        {post.minutes} min read
      </p>
    </header>

    <div class="container">
      <div class:list={['media', 'article__cover', { 'media--dusk': !cover }]}>
        {cover ? (
          <img src={cover} alt="" />
        ) : (
          <Image src={defaultPostCover} alt="" widths={[640, 1000, 1600]} sizes="(min-width: 1240px) 1128px, 100vw" width={1600} height={700} loading="eager" />
        )}
      </div>
    </div>

    <div class="container prose">
      <Fragment set:html={post.content} />
    </div>

    <footer class="container article__foot">
      <a class="btn btn--outline" href={url('/writing/')}>All Articles <Icon name="arrow" size={16} /></a>
      <a class="btn" href={url('/#contact')}>Let's Connect <Icon name="arrow" size={16} /></a>
    </footer>
  </article>
</Base>
