---
import { Image } from 'astro:assets';
import defaultPostCover from '../../assets/default-post-cover.jpg';
import Icon from '../../components/Icon.astro';
import PostGrid from '../../components/PostGrid.astro';
import Base from '../../layouts/Base.astro';
import { SITE, formatDate, fullUrl, url } from '../../config';
import { getPublishedBySlug, listPublishedOrEmpty } from '../../lib/posts';
import { textOnly } from '../../lib/sanitize';

const post = await getPublishedBySlug(Astro.params.slug ?? '');
if (!post) return Astro.rewrite('/404');

const { title, date: pubDate, updated: updatedDate, category, cover } = post;
const summary = post.description.trim() || textOnly(post.content);
const description =
  summary.length > 200 ? `${summary.slice(0, 197).trimEnd()}…` : summary || `${title} by ${SITE.name}.`;
const postUrl = fullUrl(`/writing/${post.slug}/`);
const relatedPosts = (await listPublishedOrEmpty(12))
  .filter((related) => related.slug !== post.slug && related.category === category)
  .slice(0, 3);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    articleSection: category,
    mainEntityOfPage: postUrl,
    image: fullUrl(cover ?? defaultPostCover.src),
    author: { '@type': 'Person', name: SITE.name, url: fullUrl('/') },
    publisher: { '@type': 'Person', name: SITE.name, url: fullUrl('/') },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: fullUrl('/') },
      { '@type': 'ListItem', position: 2, name: 'Writing', item: fullUrl('/writing/') },
      { '@type': 'ListItem', position: 3, name: title, item: postUrl },
    ],
  },
];
---

<Base
  title={title}
  description={description}
  image={cover ?? undefined}
  type="article"
  article={{ publishedTime: pubDate, modifiedTime: updatedDate, section: category }}
  jsonLd={jsonLd}
>
  <article class="article">
    <header class="container article__head">
      <nav class="eyebrow breadcrumb" aria-label="Breadcrumb">
        <a href={url('/')}>Home</a> / <a href={url('/writing/')}>Writing</a> / <span>{category}</span>
      </nav>
      <h1 class="page-title">{title}</h1>
      <p class="lead">{description}</p>
      <p class="post-card__meta">
        By {SITE.name}
        <span aria-hidden="true">•</span>
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span aria-hidden="true">•</span>
        {post.minutes} min read
      </p>
    </header>

    <div class="container">
      <div class:list={['media', 'article__cover', { 'media--dusk': !cover }]}>
        {cover ? (
          <img src={cover} alt={`Cover image for ${title}`} />
        ) : (
          <Image src={defaultPostCover} alt={`Cover image for ${title}`} widths={[640, 1000, 1600]} sizes="(min-width: 1240px) 1128px, 100vw" width={1600} height={700} loading="eager" />
        )}
      </div>
    </div>

    <div class="container prose">
      <Fragment set:html={post.content} />
    </div>

    <footer class="container article__foot">
      <a class="btn btn--outline" href={url('/writing/')}>All Articles <Icon name="arrow" size={16} /></a>
      <a class="btn" href={url('/#contact')}>Let's Connect <Icon name="arrow" size={16} /></a>
    </footer>

    {relatedPosts.length > 0 && (
      <section class="section section--tight" aria-labelledby="related-writing">
        <div class="container">
          <h2 id="related-writing">More in {category}</h2>
          <PostGrid posts={relatedPosts} headingLevel="h3" />
        </div>
      </section>
    )}
  </article>
</Base>
