# Local development: copy to .env and fill in. Never commit .env.
# On Hostinger these are entered in hPanel instead (see DEPLOY.md).

# Public address of the site (no trailing slash).
SITE_URL=https://ashwinchekavan.com

# Host name the admin area answers on. Leave empty to use SITE_URL/admin/.
ADMIN_HOST=admin.example.com

# MySQL connection. Use 127.0.0.1, not "localhost".
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# The one admin account. Create the hash with: npm run hash-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Long random string used to sign login sessions: openssl rand -hex 32
SESSION_SECRET=

# Where uploaded images are stored. On the server this must be a folder OUTSIDE
# the deployed app, because the app folder is replaced on every deployment.
UPLOAD_DIR=./uploads

# Optional analytics. Leave empty to add no tracking code.
GA_MEASUREMENT_ID=
CLARITY_PROJECT_ID=
